# Fund-100 isolated STOP-only worker. HARD LOCKED; never a trading service.
# No public listener, no brokerage modules, no OAuth, no signing keys.
FROM python:3.12-slim
RUN groupadd --system stopcontroller && \
    useradd --system --gid stopcontroller --no-create-home stopcontroller
WORKDIR /app
COPY --chown=stopcontroller:stopcontroller fund100_private_stop_controller_locked_v1_0.py /app/fund100_private_stop_controller_locked_v1_0.py
USER stopcontroller
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Require separately mounted writable /data durable volume at runtime.
# SOURCE_RELEASED=False prevents all operations even when built.
CMD ["python", "-u", "/app/fund100_private_stop_controller_locked_v1_0.py"]
